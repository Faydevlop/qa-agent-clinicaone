{
  "name": "clinicaone-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code QA agent for ClinicaOne: instructions, skills and Playwright suites run against deployed environments.",
  "type": "module",
  "scripts": {
    "qa": "node cli/qa.mjs",
    "setup": "npm install && npx playwright install chromium",
    "env:check": "node scripts/check-env.mjs",
    "env:resolve": "node scripts/resolve-env.mjs",
    "versions": "node scripts/versions.mjs",
    "case:discover": "node scripts/discover-case.mjs",
    "case:validate": "node scripts/validate-cases.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:api": "playwright test --project=api",
    "test:engine": "playwright test --project=engine",
    "test:e2e": "playwright test --project=e2e",
    "test:ai": "cross-env QA_ENABLE_AI=1 playwright test --grep @ai",
    "test:security": "cross-env QA_ENABLE_SECURITY=1 playwright test --grep @security",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@inquirer/prompts": "^7.8.6",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2"
  }
}
