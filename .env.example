# ClinicaOne QA agent configuration.
# Copy to `.env` and fill in. `.env` is git-ignored and Claude is denied read access to it,
# so passwords never land in a transcript. Edit secrets yourself.

# ---------------------------------------------------------------------------
# Target environment
# ---------------------------------------------------------------------------
# Either a key (dev | test | uat | preprod | prod) or just the frontend link,
# e.g. QA_TARGET=https://test.clinicaone.app  — the API URL is derived for you.
QA_TARGET=dev

# Optional overrides when an environment does not follow the
# <env>.clinicaone.app / <env>-backend.clinicaone.app convention.
# QA_WEB_URL=https://dev.clinicaone.app
# QA_API_URL=https://dev-backend.clinicaone.app/api/v1

# ---------------------------------------------------------------------------
# Credentials, one block per role.
# Generic values apply to every environment; <ENV>_ prefixed values win for that env.
# Only the learner role exists today. Add ADMIN_* etc. when new roles ship.
# ---------------------------------------------------------------------------
LEARNER_EMAIL=
LEARNER_PASSWORD=

# DEV_LEARNER_EMAIL=
# DEV_LEARNER_PASSWORD=
# TEST_LEARNER_EMAIL=
# TEST_LEARNER_PASSWORD=
# UAT_LEARNER_EMAIL=
# UAT_LEARNER_PASSWORD=

# Second learner, only needed for the opt-in @security suite (ownership / IDOR checks).
# LEARNER2_EMAIL=
# LEARNER2_PASSWORD=

# ---------------------------------------------------------------------------
# Opt-in suites (off by default)
# ---------------------------------------------------------------------------
# Calls the real AI patient (costs OpenAI money, AI limiter is 30 req/min).
# The qa CLI (npm run qa) sets these per run; values here are defaults for raw Playwright runs.
QA_ENABLE_AI=0
# Hard stop on paid AI calls per run (each patient message = one LLM completion).
QA_AI_MAX_CALLS=15
# Slow tests (idle-timeout, ~16 min).
QA_ENABLE_SLOW=0
# Ownership / exposure probes. Never run against uat or prod without the team lead's OK.
QA_ENABLE_SECURITY=0
# Any write (starting sessions, quizzes, notes) on prod is refused unless this is 1.
QA_ALLOW_PROD_WRITES=0

# Case used by engine + e2e suites when a test doesn't name one (title as shown in Case Library).
QA_DEFAULT_CASE=Pneumothorax

# Headed browser for watching E2E runs locally.
# HEADED=1
